      "用这份模板统一这五份Excel的格式" + 上传模板.xlsx + 五份文件
      "对比这两份报告，找出数字不一样的地方" + 上传两份.docx
    """
    try:
        import time, shutil

        # 保存上传文件到沙箱
        upload_dir = Path("data/uploads")
        upload_dir.mkdir(parents=True, exist_ok=True)

        file_infos = []
        for f in (files or []):
            if not f.filename: continue
